# MongoDB connection string used by the server runtime
NUXT_MONGOOSE_URI=mongodb://127.0.0.1:27017/drixal
# Alias accepted by scripts and nuxt.config.ts when NUXT_MONGOOSE_URI is empty
# MONGODB_URI=mongodb://127.0.0.1:27017/drixal

# Runtime environment: development | production
NODE_ENV=development

# Public origin used for CSRF/origin checks (e.g. https://app.example.com)
APP_ORIGIN=http://localhost:3000

# Set to "true" when the app is served behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# Slug of the demo provider company seeded in development
DEMO_COMPANY_SLUG=cool-air-services

# Guard rails for the development seed script (never run seeding against production data)
ALLOW_DEMO_SEED=true
DEMO_PASSWORD=DrixalDemo123!